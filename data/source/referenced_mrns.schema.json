{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cable-insights.local/schemas/referenced_mrns.schema.json",
  "title": "Per-source referenced MRNs",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "source", "mrns"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schema_version": { "const": 1 },
    "source": { "$ref": "#/$defs/source" },
    "mrns": {
      "type": "array",
      "items": { "$ref": "#/$defs/mrn" },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "doi", "citation", "files"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "doi": { "type": ["string", "null"], "pattern": "^10\\.[0-9]{4,9}/.+$" },
        "citation": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "items": { "type": "string", "pattern": "^data/source/.+\\.md$" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "mrn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mrn_full", "mrn_normalized"],
      "properties": {
        "mrn_full": { "type": "string", "pattern": "^197[3-9][A-Z]{3,8}[0-9]{4,6}$" },
        "mrn_normalized": { "type": "string", "pattern": "^(?:[0-9]{2}|19[0-9]{2})[A-Z][A-Z ]{2,15}[0-9]+$" }
      }
    }
  }
}
